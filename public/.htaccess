# Disable directory indexing
Options -Indexes

# Block sensitive and hidden files
<FilesMatch "^\.|\.(env|json|lock|log|sql|md|toml|yml|yaml|ts|tsx)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Allow public web assets (.json manifests if any)
<FilesMatch "^(manifest\.json|robots\.txt|sitemap\.xml)$">
  Order allow,deny
  Allow from all
</FilesMatch>

# Security Headers
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# Single Page Application (SPA) Routing & Redirects
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirect old /blogs/ URLs to homepage
  RewriteRule ^blogs/10-best-nursing-colleges-in-tamilnadu\.html$ / [R=301,L]
  RewriteRule ^blogs/(.*)$ / [R=301,L]
  RewriteRule ^10-best-nursing-colleges-in-tamilnadu\.html$ / [R=301,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
